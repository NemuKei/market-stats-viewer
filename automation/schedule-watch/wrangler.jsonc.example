{
  "name": "example-schedule-watch",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "vars": {
    "WATCH_ENABLED": false,
    "SEND_NOTICES": false,
    "REALTIME_NOTICES": true,
    "WATCH_CONFIG": { "targets": [] }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "example-schedule-watch",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
